  <property name="styleSheet">
   <string notr="true">
QMainWindow { background:#f4f6f8; }
QWidget { color:#182230; font-family:"Microsoft YaHei UI","Segoe UI"; font-size:13px; }
QFrame[panel="true"], QFrame[card="true"], QFrame[summaryCard="true"] {
    background:#ffffff; border:1px solid #d8dee7; border-radius:10px;
}
QFrame#frameSidebar { background:#ffffff; border:1px solid #d8dee7; border-radius:7px; }
QLabel[role="sectionTitle"] { color:#172b4d; font-size:15px; font-weight:800; }
QLabel[role="summaryTitle"] { color:#475467; font-size:12px; font-weight:700; }
QLabel[role="summaryValue"] { font-size:25px; font-weight:800; }
QLabel[role="summaryDetail"] { color:#667085; font-size:11px; background:#f2f4f7; border-radius:7px; padding:2px 7px; }
QFrame[summaryCard="true"] { background:#ffffff; border:1px solid #d9e0ea; border-radius:10px; }
QFrame#frameSummaryVoltage { background:#f7fcf8; border-top:3px solid #22a559; }
QFrame#frameSummaryCurrent { background:#f6f9ff; border-top:3px solid #2878df; }
QFrame#frameSummarySoc { background:#f6f7f8; border:1px solid #d9dde3; border-top:3px solid #98a2b3; }
QLabel#labelSocTitle, QLabel#labelSoc, QLabel#labelSocSource { color:#98a2b3; }
QFrame#frameSummaryTemperature { background:#fffaf3; border-top:3px solid #f59e42; }
QFrame#frameSummaryAlarm { background:#fff1f2; border:2px solid #e5484d; }
QLabel#labelAlarmTitle { color:#a61b29; font-weight:800; }
QFrame#frameSummaryBalance { background:#f7fbff; border-top:3px solid #5b8def; }
QLabel[role="fieldLabel"] { color:#344054; min-width:56px; }
QLabel#labelConnectionStatus { color:#667085; font-weight:600; padding:4px 0; }
QLabel[role="key"] { color:#475467; }
QLabel[role="value"] { color:#182230; }
QLabel#labelFaultSummary { color:#168a45; font-size:23px; font-weight:700; padding:4px; }
QComboBox, QPushButton, QPlainTextEdit, QTableWidget {
    background:#ffffff; border:1px solid #cfd6e0; border-radius:5px;
}
QComboBox { min-height:30px; padding:0 9px; }
QPushButton { min-height:31px; padding:0 12px; }
QPushButton:hover { border-color:#1677ff; color:#0b63ce; background:#f1f7ff; }
QPushButton:pressed { background:#e5f0ff; }
QPushButton#buttonSendCommand { color:white; background:#276fce; border-color:#276fce; font-weight:600; min-height:36px; }
QPushButton#buttonSendCommand:hover { background:#1f62b8; color:white; }
QPlainTextEdit#plainTextEditCommLog { color:#168a45; background:#fbfcfd; font-family:Consolas,"Microsoft YaHei UI"; font-size:11px; padding:5px; }
QFrame#frameQualityStrip { background:#fff9ed; border:1px solid #f2cf87; border-radius:6px; }
QLabel#labelQualityIcon { color:#ffffff; background:#f79009; border-radius:5px; padding:2px 7px; font-size:11px; font-weight:800; }
QLabel#labelQualityText { color:#9a4e00; font-weight:600; }
QFrame#frameCells { background:#ffffff; border:1px solid #cdd9e8; border-radius:10px; }
QLabel#labelCellsTitle { color:#163a67; background:#edf4ff; border-left:4px solid #2878df; border-radius:5px; padding:3px 8px; font-size:15px; font-weight:800; }
QFrame[cellCard="true"] { background:#f8fcf8; border:1px solid #cfe2d3; border-radius:8px; min-height:72px; }
/* 最高单体使用蓝色边框，最低单体使用红色边框。 */
QFrame[cellCard="true"][voltageState="highest"] {
    background:#f5f9ff;
    border:2px solid #1677ff;
}

QFrame[cellCard="true"][voltageState="lowest"] {
    background:#fff7f7;
    border:2px solid #e5484d;
}
/* 单体电压文字颜色跟随最高、最低状态变化。 */
QLabel[role="cellValue"][voltageState="highest"] {
    color:#1677ff;
}

QLabel[role="cellValue"][voltageState="lowest"] {
    color:#d92d36;
}
QLabel[role="cellName"] { color:#344054; font-weight:600; }
QLabel[role="cellValue"] { color:#168a45; font-size:20px; font-weight:700; }

QLabel#labelCellBadge2 { color:white; background:#1677ff; border-radius:4px; padding:2px 5px; font-size:11px; font-weight:700; }
QLabel#labelCellBadge4 { color:white; background:#e5484d; border-radius:4px; padding:2px 5px; font-size:11px; font-weight:700; }
QLabel#labelCellBalance2 { color:#f79009; font-weight:600; font-size:12px; }
QLabel#labelCellDiffTitle { color:#9a4e00; font-weight:800; }
QLabel#labelCellDiff { color:#f07818; font-size:22px; font-weight:800; }
QFrame[detailCard="true"] { background:#ffffff; border:1px solid #d8e0eb; border-radius:10px; }
QFrame#frameStatusInfo { background:#f8fbff; border-top:3px solid #2878df; }
QFrame#frameFaultDiag { background:#f8fcf9; border-top:3px solid #22a559; }
QFrame#frameBalanceDetail { background:#fffaf3; border-top:3px solid #f59e42; }
QLabel#labelStatusInfoTitle, QLabel#labelFaultTitle, QLabel#labelBalanceDetailTitle { padding:6px 7px; border-bottom:1px solid #dfe5ed; font-size:15px; font-weight:800; }
QLabel#labelAlarmFlags, QLabel#labelProtectFlags, QLabel#labelCurrentDirection, QLabel#labelStatusTemperature,
QLabel#labelRuntimeFault, QLabel#labelHwFault, QLabel#labelBringUpFault { background:rgba(255,255,255,185); border:1px solid #e5eaf0; border-radius:5px; padding:5px 7px; font-family:Consolas,"Microsoft YaHei UI"; }
QLabel#labelFaultSummary { background:#ffffff; border:1px solid #dce7df; border-radius:7px; min-height:38px; }
QLabel#labelBalanceActive, QLabel#labelBalanceTargetCount, QLabel#labelBalanceTarget,
QLabel#labelCellBal1, QLabel#labelCellBal2, QLabel#labelCellBal3, QLabel#labelBalancePhase { background:rgba(255,255,255,190); border:1px solid #eee4d5; border-radius:4px; padding:3px 7px; }
QLabel#labelBalanceStateTitle, QLabel#labelBalanceCountTitle, QLabel#labelBalanceTargetTitle,
QLabel#labelCellBal1Title, QLabel#labelCellBal2Title, QLabel#labelCellBal3Title, QLabel#labelBalancePhaseTitle { color:#667085; font-weight:700; }
QLabel[state="danger"] { color:#d92d36; font-weight:600; }
QLabel[state="warning"] { color:#f07818; font-weight:600; }
QLabel[state="good"] { color:#168a45; font-weight:600; }
QTableWidget { gridline-color:#e4e7ec; alternate-background-color:#f8fafc; selection-background-color:#e8f1ff; selection-color:#182230; }
QHeaderView::section { color:#344054; background:#f2f4f7; border:none; border-right:1px solid #dfe3e8; border-bottom:1px solid #d4dae3; padding:6px; font-weight:600; }
QFrame#frameBottomStatus { background:#ffffff; border-top:1px solid #d8dee7; }
QLabel[role="statusItem"] { color:#344054; margin:0 10px; }
QLabel#labelRunState { color:#168a45; font-weight:700; }
QScrollArea { background:transparent; border:none; }
QScrollBar:vertical { background:#eef1f5; width:10px; margin:0; }
QScrollBar::handle:vertical { background:#b8c0cc; min-height:28px; border-radius:5px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; }

/* Single-screen dashboard: 1440x820 / 1366x768 logical pixels. */
QWidget { font-size:12px; }
QFrame[panel="true"], QFrame[summaryCard="true"], QFrame[detailCard="true"] { border-radius:6px; }
QLabel[role="sectionTitle"] { font-size:13px; font-weight:700; }
QLabel[role="summaryValue"] { font-size:22px; }
QLabel[role="summaryDetail"] { font-size:10px; padding:0; background:transparent; }
QLabel#labelCellsTitle { background:transparent; border:none; padding:0; font-size:13px; }
QFrame[cellCard="true"] { min-height:0; border-radius:5px; }
QLabel[role="cellValue"] { font-size:18px; }
QLabel[role="cellName"] { font-size:11px; }
QFrame#frameCellDiff { min-height:0; background:transparent; border:none; }
QLabel#labelCellDiff, QLabel#labelCellDiffTitle { font-size:13px; }
QLabel#labelCellExtrema { color:#667085; font-size:11px; }
QLabel#labelStatusInfoTitle, QLabel#labelFaultTitle, QLabel#labelBalanceDetailTitle { padding:0; border:none; font-size:13px; }
QLabel#labelAlarmFlags, QLabel#labelProtectFlags, QLabel#labelCurrentDirection, QLabel#labelStatusTemperature,
QLabel#labelRuntimeFault, QLabel#labelHwFault, QLabel#labelBringUpFault { background:transparent; border:none; padding:0; font-size:11px; }
QLabel#labelFaultSummary { min-height:0; background:transparent; border:none; padding:0; font-size:16px; }
QLabel#labelBalanceActive, QLabel#labelBalanceTargetCount, QLabel#labelBalanceTarget,
QLabel#labelCellBal1, QLabel#labelCellBal2, QLabel#labelCellBal3, QLabel#labelBalancePhase { border:none; padding:0; background:transparent; font-size:11px; }
QLabel#labelBalanceStateTitle, QLabel#labelBalanceCountTitle, QLabel#labelBalanceTargetTitle,
QLabel#labelCellBal1Title, QLabel#labelCellBal2Title, QLabel#labelCellBal3Title, QLabel#labelBalancePhaseTitle { font-size:10px; }
QFrame#frameQualityStrip { border:none; background:transparent; }
QLabel#labelQualityText { font-size:10px; font-weight:400; }
QLabel#labelQualityIcon { padding:0 4px; font-size:10px; }
QComboBox, QPushButton { min-height:25px; }
QPushButton { padding:0 7px; }
QPushButton#buttonSendCommand { min-height:28px; }
QLabel#labelConnectionStatus { padding:0; font-size:11px; }
QLabel[role="statusItem"] { margin:0 5px; font-size:11px; }
QHeaderView::section { padding:3px; }</string>
